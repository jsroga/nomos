{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/pages/**/*.{ts,tsx}",
    "src/mcp/server.ts",
    "src/trigger/**/*.ts",
    "trigger.config.ts",
    "scripts/**/*.{ts,js,mjs}",
    "e2e/**/*.ts",
    "src/evaluation/experiments/**/*.ts",
    "src/evaluation/confident-ai/run-experiment.ts",
    "src/evaluation/hypothesis/run-experiment.ts",
    "src/evaluation/scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js,mjs}", "e2e/**/*.ts"],
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.e2e.test.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    ".next/**",
    "dist/**",
    "scripts/deepeval/venv/**",
    "public/scripts/**",
    "src/evaluation/experiments/eval-architecture.ts",
    "src/evaluation/experiments/extended-thinking-ab-test.ts",
    "src/evaluation/experiments/loop-creator.ts",
    "e2e/parallel-runner.ts",
    "src/components/LiquidGlass.tsx",
    "src/domains/chat/components/ContextChips.tsx",
    "src/domains/chat/components/HoverActions.tsx",
    "src/domains/chat/components/index.ts",
    "src/domains/chat/components/SuggestionCard.tsx"
  ],
  "ignoreDependencies": [
    "@types/*",
    "server-only",
    "eslint-*",
    "@anthropic-ai/sdk",
    "@mastra/observability",
    "webpack"
  ],
  "ignoreBinaries": [
    "tsx",
    "live-server"
  ],
  "ignoreExportsUsedInFile": true
}

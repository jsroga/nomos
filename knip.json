{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/mcp/server.ts",
    "src/trigger/**/*.ts",
    "trigger.config.ts",
    "scripts/**/*.{ts,js,mjs}",
    "e2e/**/*.ts",
    "evals/run.ts",
    "evals/scorers/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js,mjs}", "e2e/**/*.ts", "evals/**/*.ts"],
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.e2e.test.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    ".next/**",
    "dist/**",
    "public/scripts/**",
    "src/domains/chat/components/index.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "server-only",
    "eslint-*",
    "@anthropic-ai/sdk",
    "webpack"
  ],
  "ignoreBinaries": [
    "tsx",
    "live-server"
  ],
  "ignoreExportsUsedInFile": true
}

{
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "command": "./.cursor/hooks/guard-agent-artifacts.sh", "matcher": "Write" }
    ],
    "afterFileEdit": [
      { "command": "./.cursor/hooks/record-src-edits.sh" },
      { "command": "./.cursor/hooks/record-mastra-edits.sh" },
      { "command": "./.cursor/hooks/record-plan-edits.sh" },
      { "command": "./.cursor/hooks/format-on-edit.sh" }
    ],
    "beforeShellExecution": [
      { "command": "./.cursor/hooks/guard-destructive.sh" },
      { "command": "./.cursor/hooks/guard-commit.sh", "matcher": "git commit" }
    ],
    "sessionStart": [
      { "command": "./.cursor/hooks/session-init.sh" }
    ],
    "stop": [
      { "command": "./.cursor/hooks/plan-critique-on-stop.sh", "loop_limit": 1 },
      { "command": "./.cursor/hooks/e2e-required-after-plan.sh", "loop_limit": 1 },
      { "command": "./.cursor/hooks/fast-verify-on-stop.sh", "loop_limit": 2 },
      { "command": "./.cursor/hooks/mastra-smoke-on-stop.sh", "loop_limit": 2 }
    ]
  }
}

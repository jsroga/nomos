{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      { "command": "./.cursor/hooks/record-src-edits.sh" },
      { "command": "./.cursor/hooks/format-on-edit.sh" }
    ],
    "beforeShellExecution": [
      { "command": "./.cursor/hooks/guard-destructive.sh" }
    ],
    "sessionStart": [
      { "command": "./.cursor/hooks/session-init.sh" }
    ],
    "stop": [
      { "command": "./.cursor/hooks/fast-verify-on-stop.sh", "loop_limit": 1 }
    ]
  }
}

{
  "projectId": "e7a5dd6d-6489-4bea-a49d-337833a8e339",
  "shape": "package",
  "pkg": "world-building-kit",
  "globalName": "WorldBuildingKit",
  "entry": "./.design-sync/ds-entry.ts",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.json",
  "buildCmd": "npx tailwindcss -c .design-sync/tailwind.ds.config.js -i src/app/globals.css -o .design-sync/.cache/ds-tailwind.css && cat .design-sync/fonts-header.css .design-sync/.cache/ds-tailwind.css .design-sync/fonts-vars.css > .design-sync/.cache/ds-styles.css && npx tsc -p .design-sync/tsconfig.dts.json",
  "cssEntry": ".design-sync/.cache/ds-styles.css",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": [],
  "extraEntries": ["./.design-sync/ds-frame.tsx"],
  "provider": { "component": "DsFrame" },
  "overrides": {
    "BleedingText": { "cardMode": "column" },
    "Button": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "GlowEffect": { "cardMode": "column" },
    "Input": { "cardMode": "column" },
    "Progress": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },
    "Slider": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "AlertDialog": { "cardMode": "single", "viewport": "720x480" },
    "ConfirmDialog": { "cardMode": "single", "viewport": "720x480" },
    "Dialog": { "cardMode": "single", "viewport": "720x520" },
    "ImageLightbox": { "cardMode": "single", "viewport": "800x600" },
    "DropdownMenu": { "cardMode": "single", "viewport": "480x420" },
    "Tooltip": { "cardMode": "single", "viewport": "480x240" },
    "DomainSidebar": { "cardMode": "column" }
  },
  "dtsPropsFor": {
    "Button": "variant?: 'default' | 'destructive' | 'outline' | 'secondary' | 'ghost' | 'link';\n  size?: 'default' | 'sm' | 'lg' | 'icon';\n  /** Render as the child element (Radix Slot) instead of a <button>. */\n  asChild?: boolean;\n  disabled?: boolean;\n  className?: string;\n  children?: React.ReactNode;\n  onClick?: React.MouseEventHandler<HTMLButtonElement>;",
    "Badge": "variant?: 'default' | 'secondary' | 'destructive' | 'outline';\n  className?: string;\n  children?: React.ReactNode;"
  },
  "componentSrcMap": {
    "AlertDialog": "src/components/AlertDialog/AlertDialog.tsx",
    "Avatar": "src/components/Avatar/Avatar.tsx",
    "Badge": "src/components/Badge/Badge.tsx",

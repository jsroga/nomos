    "ImageLightbox": "src/components/ImageLightbox/ImageLightbox.tsx",
    "Input": "src/components/Input/Input.tsx",
    "Label": "src/components/Label/Label.tsx",
    "LiquidDistortionText": "src/components/TextEffects/TextEffects.tsx",
    "MotionHighlight": "src/components/TextEffects/TextEffects.tsx",
    "Progress": "src/components/Progress/Progress.tsx",
    "ScrollArea": "src/components/ScrollArea/ScrollArea.tsx",
    "Skeleton": "src/components/Skeleton/Skeleton.tsx",
    "Slider": "src/components/Slider/Slider.tsx",

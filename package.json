  "scripts": {
    "prepare": "husky",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs-updated.mjs",
    "check:lint": "eslint .",
    "precommit": "node scripts/pre-commit.mjs",
    "build": "next build --webpack",
    "dev": "next dev --webpack -p 3000",
    "dev:webpack": "next dev --webpack -p 3000",
    "mastra:dev": "env -u ANTHROPIC_BASE_URL mastra dev -e .env.local",
    "mastra:build": "mastra build --studio",
    "mastra:smoke": "node scripts/mastra-smoke.mjs",
    "mcp:build": "tsc -p src/mcp/tsconfig.json",
    "storyteller:orchestrate": "npx tsx scripts/storyteller-orchestrate.ts",
    "storyteller:repl": "npx tsx scripts/storyteller-repl.ts",
    "storyteller:controller": "npx tsx scripts/storyteller-controller-cli.ts",
    "dev:turbo": "next dev -p 3000",
    "eval": "npx tsx evals/run.ts",
    "eval:ideas": "npx tsx evals/run.ts --dataset=idea-diversity",
    "test:smoke:openrouter": "RUN_OPENROUTER_SMOKE=1 npx vitest run src/domains/__tests__/openrouter-smoke.test.ts",
    "test:smoke:tile-providers": "npx vitest run --config vitest.tile-providers.config.ts",
    "eval:dashboard": "npx tsx evals/report/generate.ts && open evals/reports/latest.html",
    "test:unit": "vitest run",
    "test:e2e": "npx tsx scripts/run-e2e.ts",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js .",
    "lint:fix": "eslint . --fix",
    "lint:file": "eslint --max-warnings 0",
    "qualitygate:file": "node scripts/qualitygate.mjs file",
    "qualitygate:changed": "node scripts/qualitygate.mjs changed",
    "qualitygate:capture": "node scripts/qualitygate.mjs capture",
    "qualitygate:backlog": "node scripts/qualitygate.mjs backlog",
    "qualitygate:metrics": "node scripts/qualitygate.mjs metrics",
    "qualitygate:tsc": "node scripts/qualitygate.mjs tsc",
    "qualitygate:tracker": "node scripts/qualitygate.mjs tracker",
    "verify:file": "npm run qualitygate:file --",
    "verify:batch": "npm run qualitygate:changed --",
    "verify:fast": "npm run qualitygate:changed --",
    "quality:capture": "npm run qualitygate:capture --",
    "quality:backlog": "npm run qualitygate:backlog --",
    "typecheck:file": "npm run qualitygate:tsc -- --files",
    "typecheck:fast": "npm run qualitygate:tsc -- --changed",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit && npm run qualitygate:metrics",
    "mcp:start": "npx tsx src/mcp/stdio.ts",
    "start": "next start",
    "test:playwright:install": "playwright install --with-deps",
    "trigger:dev": "CI=1 npx trigger.dev@4.5.9 dev",
    "trigger:deploy": "OTEL_TRACES_EXPORTER=none npx trigger.dev@latest deploy --env prod",
    "audit:cwv": "node scripts/audit-cwv.mjs",
    "marketing:glb-lite": "node scripts/marketing-glb-lite.mjs",
    "analyze": "ANALYZE=1 next build --webpack"

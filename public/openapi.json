              "loop-creator",
              "3d-canvas",
              "2d-canvas"
            ]
          },
          "source_entity_id": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_url": {
            "type": "string",
            "nullable": true
          },
          "used_in_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "user_id",
          "entity_type",
          "name",
          "description",
          "source_domain",
          "source_entity_id",
          "metadata",
          "tags",
          "image_url",
          "used_in_domains",
          "created_at",
          "updated_at"
        ]
      },
      "EntitiesListResponse": {
        "type": "object",
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameEntity"
            }
          }
        },
        "required": [
          "entities"
        ]
      },
      "EntityResponse": {
        "type": "object",
        "properties": {
          "entity": {
            "$ref": "#/components/schemas/GameEntity"
          }
        },
        "required": [
          "entity"
        ]
      },
      "CreateEntityRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "entityType": {
            "type": "string",

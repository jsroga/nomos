              "part_of"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "projectId",
          "fromEntityId",
          "toEntityId",
          "relationshipType"
        ]
      },

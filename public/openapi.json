              "location",
              "mechanic",
              "faction",
              "item",
              "quest"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sourceDomain": {
            "type": "string",
            "enum": [
              "storyteller",
              "loop-creator",
              "3d-canvas",
              "2d-canvas"
            ]
          },
          "sourceEntityId": {
            "type": "string",
            "format": "uuid"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "projectId",
          "entityType",
          "name",
          "sourceDomain"
        ]
      },
      "UpdateEntityRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "usedInDomains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "storyteller",
                "loop-creator",
                "3d-canvas",
                "2d-canvas"
              ]
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        }
      },
      "EntityRelationship": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "from_entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "to_entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "relationship_type": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "id",
          "project_id",
          "from_entity_id",
          "to_entity_id",
          "relationship_type"
        ]
      },
      "RelationshipsListResponse": {
        "type": "object",
        "properties": {
          "relationships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityRelationship"
            }
          }
        },
        "required": [
          "relationships"
        ]
      },
      "RelationshipResponse": {
        "type": "object",
        "properties": {
          "relationship": {
            "$ref": "#/components/schemas/EntityRelationship"
          }
        },
        "required": [
          "relationship"
        ]
      },
      "CreateRelationshipRequest": {
        "type": "object",
        "properties": {

digraph Execute {
    graph [
        goal="Clarify scope with the human, produce a reviewable plan, optionally implement it, verify (module typecheck + lint + husky pre-commit parity: architecture, docs, unit tests, build), and finish with an evidence-based retro. Verify retries up to 3 fix turns; a failing verify does not block exit — ship to retro for PR anyway."

        model_stylesheet="
            *          { model: gpt-5.4;         reasoning_effort: medium; }
            .scope     { model: claude-opus-4-8; reasoning_effort: high;   }
            .review    { model: codex;           reasoning_effort: low;    }
            .planning  { model: claude-fable-5; reasoning_effort: high;   }
            .build     { model: codex;           reasoning_effort: high;   }
            .retro     { model: gpt-5.4;         reasoning_effort: medium; }
        "

        default_max_retries=1
        default_fidelity="summary:medium"
        stall_timeout="1800s"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    scope [
        label="Scope\nagent: Scope Runner\nmodel: claude-opus-4-8"
        class="scope"
        model="claude-opus-4-8"
        provider="anthropic"
        prompt="@prompts/scope.md"
        max_visits=2
    ]

    clarify_prep [
        label="Clarify Prep\nagent: Clarify Facilitator\nmodel: codex"
        class="review"
        prompt="@prompts/clarify-prep.md"
        retry_policy="patient"
        max_retries=2
        max_visits=2
    ]

    clarify [
        shape=hexagon
        label="Pick scope [A] [B] [C] — meanings are module-specific (see Clarify Prep table). [F] custom · [R] re-scope"
        question_type="multiple_choice"
        timeout="86400s"
        human.default_choice="plan"
    ]

    plan [
        label="Plan (Architect)\nagent: Plan Author\nmodel: claude-fable-5"
        class="planning"
        prompt="@prompts/plan.md"
        fidelity="summary:high"
        goal_gate=true
        retry_policy="patient"
        max_retries=2
        max_visits=3
    ]

    verification [
        shape=hexagon
        label="Plan is ready. [A] build · [B] plan only · [I] iterate (notes) · [X] abort — do not reuse clarify's A/B/C here"
        question_type="multiple_choice"
        timeout="86400s"
        human.default_choice="retro"
    ]

    setup [
        label="Bootstrap\n[shell · npm ci]"
        shape=parallelogram
        script="set -euo pipefail; echo '=== sandbox bootstrap ==='; if ! command -v git >/dev/null; then apt-get update && apt-get install -y git ca-certificates; fi; if ! command -v npm >/dev/null; then apt-get update && apt-get install -y nodejs npm; fi; command -v npm >/dev/null || { echo 'ERROR: npm still missing — expected image node:22-bookworm'; exit 1; }; npm ci --prefer-offline --no-audit --no-fund; echo '=== bootstrap complete ==='"
        max_visits=2
    ]

    developer [
        label="Implement\nagent: Developer\nmodel: codex"
        class="build"
        model="codex"
        provider="openai"
        prompt="@prompts/implement.md"
        permissions="full"
        max_visits=4
    ]

    verify [
        label="Verify\n[shell · fabro-verify: module gates + pre-commit parity]"
        shape=parallelogram
        script="set -euo pipefail; node scripts/fabro-verify.mjs"
        max_visits=5
    ]

    retro [
        label="Retro\nagent: Retro Author\nmodel: gpt-5.4"
        class="retro"
        prompt="@prompts/retro.md"
        max_visits=2
    ]

    start -> scope
    scope -> clarify_prep [fidelity="compact"]
    clarify_prep -> clarify

    clarify -> plan [label="[A]", fidelity="compact"]
    clarify -> plan [label="[B]", fidelity="compact"]
    clarify -> plan [label="[C]", fidelity="compact"]
    clarify -> plan [label="[F] Custom scope", freeform=true, fidelity="compact"]
    clarify -> scope [label="[R] Re-scope"]
    clarify -> exit [label="Unanswered — abort", condition="outcome=failed"]

    plan -> verification [condition="outcome=succeeded"]
    plan -> exit [label="Plan failed — abort (fable-5 required)"]

    verification -> setup      [label="[A] Approve & build"]
    verification -> retro       [label="[B] Approve, plan only"]
    verification -> plan        [label="[I] Iterate with notes", freeform=true]
    verification -> exit        [label="[X] Abort"]
    verification -> exit        [label="Unanswered — abort", condition="outcome=failed"]

    setup -> developer
    developer -> verify

    verify -> retro      [label="Pass", condition="outcome=succeeded"]
    verify -> developer  [label="Fix", condition="outcome=failed && internal.node_visit_count < 4", fidelity="compact"]
    verify -> retro      [label="Ship anyway — verify still failing"]

    retro -> exit
}

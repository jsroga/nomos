digraph Plan {
    graph [
        goal="Assess a module, clarify ambiguities with the human, produce a reviewable improvement plan aligned to the target architecture, gate it at Verification, then OPTIONALLY build it (UX → implement → verify → test → e2e) and finish with Retro"

        model_stylesheet="
            *          { model: gpt-5.4;         reasoning_effort: medium; }
            .review    { model: codex;           reasoning_effort: low;    }
            .planning  { model: gpt-5.4;         reasoning_effort: high;   }
            .design    { model: gpt-5.4;         reasoning_effort: medium; }
            .build     { model: codex;           reasoning_effort: high;   }
            .testing   { model: gpt-5.4;         reasoning_effort: medium; }
            .visual    { model: gpt-5.4;         reasoning_effort: medium; }
            .retro     { model: gpt-5.4;         reasoning_effort: medium; }
        "

        default_max_retries=1
        default_fidelity="summary:medium"
        stall_timeout="1800s"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    scope [
        label="Scope\nagent: Scope Runner\nmodel: codex"
        class="review"
        prompt="@prompts/scope.md"
        max_visits=2
    ]

    assess [
        label="Assess\nagent: Architecture Assessor\nmodel: codex"
        class="review"
        prompt="@prompts/assess.md"
        retry_policy="patient"
        max_retries=2
        max_visits=2
    ]

    clarify_prep [
        label="Clarify Prep\nagent: Clarify Facilitator\nmodel: codex"
        class="review"
        prompt="@prompts/clarify-prep.md"
        retry_policy="patient"
        max_retries=2
        max_visits=2
    ]

    Clarify [
        shape=hexagon
        label="Choose scope A, B, or C for this module (see Clarify Prep summary — table defines what each means here)"
        question_type="multiple_choice"
        timeout="86400s"
        human.default_choice="plan"
    ]

    // goal_gate + retry_target=clarify_prep: on plan failure, loops to clarify_prep
    // (max_visits=2). clarify_prep skips re-prompting if human.gate.Clarify.* is set.
    // Human is NOT re-asked at Clarify unless clarify_prep exhausts visits and the
    // graph re-enters Clarify from a different path — plan max_visits=5 caps total.
    plan [
        label="Plan (Architect)\nagent: Plan Author\nmodel: claude-opus-4-8"
        class="planning"
        prompt="@prompts/plan.md"
        fidelity="summary:high"
        goal_gate=true
        retry_target="clarify_prep"
        max_visits=5
    ]

    Verification [
        shape=hexagon
        label="Plan is ready. [A] build · [B] plan only · [I] iterate (notes) · [X] abort — do not reuse Clarify's A/B/C here"
        question_type="multiple_choice"
        timeout="86400s"
        human.default_choice="Retro"
    ]

    setup [
        label="Bootstrap\n[shell · npm ci + Playwright]"
        shape=parallelogram
        script="set -euo pipefail; echo '=== sandbox bootstrap ==='; if ! command -v git >/dev/null; then apt-get update && apt-get install -y git ca-certificates; fi; if ! command -v npm >/dev/null; then apt-get update && apt-get install -y nodejs npm; fi; command -v npm >/dev/null || { echo 'ERROR: npm still missing — expected image node:22-bookworm'; exit 1; }; npm ci --prefer-offline --no-audit --no-fund; npm run test:playwright:install; echo '=== bootstrap complete ==='"
        max_visits=2
    ]

    setup_gate [shape=diamond, label="Bootstrap OK?"]

    setup_fail [
        label="Bootstrap failed\n[shell · notify]"
        shape=parallelogram
        script="echo '=== BOOTSTRAP FAILED ===' >&2; echo 'Node.js/npm not available. Expected Docker image: node:22-bookworm.' >&2; echo 'Check workflow.toml [environments.plan-docker.image] and ../../docker/plan-sandbox.Dockerfile.' >&2; exit 1"
        max_visits=2
    ]

    subgraph cluster_build {
        label="Optional Build"
        node [thread_id="build", fidelity="full"]

        ux_designer [
            label="UX Designer\nagent: UX Designer\nmodel: gpt-5.4"
            class="design"
            prompt="@../feature/prompts/ux-designer.md"
            max_visits=2
        ]

        developer [
            label="Implement\nagent: Developer\nmodel: codex"
            class="build"
            prompt="@prompts/implement.md"
            permissions="full"
            max_visits=3
        ]

        tester [
            label="Tester\nagent: Tester\nmodel: gpt-5.4"
            class="testing"
            prompt="@../feature/prompts/tester.md"
            max_visits=3
        ]

        screenshot [
            label="UI Screenshot\nagent: UI Screenshotter\nmodel: gpt-5.4"
            class="visual"
            prompt="@prompts/screenshot.md"
            retry_policy="patient"
            max_retries=1
            max_visits=2
        ]
    }

    verify [
        label="Typecheck + Lint\n[shell · no agent]"
        shape=parallelogram
        script="set -euo pipefail; node scripts/fabro-verify.mjs"
        max_visits=5
    ]
    verify_gate [shape=diamond, label="Static checks pass?"]

    run_tests [
        label="Unit Tests\n[shell · npm run test:unit]"
        shape=parallelogram
        script="npm run test:unit"
        max_visits=5
    ]
    test_gate [shape=diamond, label="Unit tests pass?"]

    run_e2e [
        label="E2E Full\n[shell · npm run test:e2e full-loop]"
        shape=parallelogram
        script="npm run test:e2e full-loop"
        max_visits=3
    ]
    e2e_gate [shape=diamond, label="E2E pass?"]

    // Preview (Preview doc): start a dev server, then a human gate so the human
    // can open the running app before finishing. Preview URLs require the DAYTONA
    // provider (run with `--environment plan-daytona --preserve-sandbox`); on
    // local/docker the gate still pauses for manual review but generates no URL.
    serve [
        label="Dev server\n[shell · npm run dev :3000]"
        shape=parallelogram
        script="(npm run dev >/tmp/devserver.log 2>&1 &) ; echo 'started next dev on :3000 — Daytona: open Preview or `fabro sandbox preview <run> 3000`'; for i in $(seq 1 20); do curl -sf http://localhost:3000 >/dev/null 2>&1 && { echo 'dev server up'; break; }; sleep 3; done; true"
        max_visits=2
    ]

    Preview [
        shape=hexagon
        label="Preview the running app on port 3000 (Daytona: Preview button or `fabro sandbox preview <run> 3000`). Approve, revise, or skip."
        question_type="multiple_choice"
        timeout="86400s"
        human.default_choice="Retro"
    ]

    Retro [
        label="Retro\nagent: Retro Author\nmodel: gpt-5.4"
        class="retro"
        prompt="@prompts/retro.md"
        max_visits=2
    ]

    // ── Wiring ───────────────────────────────────────────────────────────
    // scope→assess carries the module file tree + git status as command.output.
    // assess.md tells the agent to REUSE that tree (not re-glob), so force
    // fidelity=compact on this edge — summary:medium can truncate a 120-line tree.
    start -> scope
    scope -> assess [fidelity="compact"]
    assess -> clarify_prep -> Clarify

    // A/B/C are accelerators only — module-specific meanings come from clarify_prep dock.
    Clarify -> plan [label="[A] Staged migration"]
    Clarify -> plan [label="[B] Minimal first step"]
    Clarify -> plan [label="[C] Full blueprint"]
    Clarify -> plan [label="[F] Custom scope", freeform=true]
    Clarify -> assess [label="[R] Re-assess"]
    // Fail closed (Interviews/HITL): Interrupted/Skipped never approve; give the
    // unanswered path an explicit terminal route instead of a silent stuck state.
    Clarify -> exit [label="Unanswered — abort", condition="outcome=failed"]

    // Only a SUCCESSFUL plan reaches Verification. A failed plan (LLM/provider
    // error, e.g. dead Anthropic credits) must NOT march into build on an empty/stale
    // PLAN.md — route it to Retro so the failure is documented instead of silent.
    plan -> Verification [condition="outcome=succeeded"]
    plan -> Retro        [label="Plan failed — no valid plan to build"]

    Verification -> setup      [label="[A] Approve & build"]
    Verification -> Retro       [label="[B] Approve, plan only"]
    Verification -> plan        [label="[I] Iterate with notes", freeform=true]
    Verification -> exit        [label="[X] Abort"]
    Verification -> exit        [label="Unanswered — abort", condition="outcome=failed"]

    setup -> setup_gate
    setup_gate -> ux_designer [label="UI increment", condition="outcome=succeeded && plan.has_ui_surface=yes"]
    setup_gate -> developer   [label="Backend increment", condition="outcome=succeeded"]
    setup_gate -> setup_fail
    setup_fail -> exit

    ux_designer -> developer -> verify -> verify_gate

    // Fix loops: the developer node is fidelity=full (no preamble), so on a Fix
    // transition it would NOT see the failing command.output. Force compact on the
    // Fix edges so the typecheck/lint/test/e2e failures are injected into its
    // preamble. Bail to Retro after a bounded number of gate visits
    // (internal.node_visit_count — the doc's fixed-count-loop pattern) so a stuck
    // build documents itself instead of hard-failing on developer's max_visits.
    verify_gate -> tester    [label="Pass", condition="outcome=succeeded"]
    verify_gate -> developer [label="Fix", condition="outcome=failed && internal.node_visit_count < 3", fidelity="compact"]
    verify_gate -> Retro     [label="Static checks still failing after retries"]

    tester -> run_tests -> test_gate

    test_gate -> run_e2e [label="Pass", condition="outcome=succeeded"]
    test_gate -> developer [label="Fix", condition="outcome=failed && internal.node_visit_count < 3", fidelity="compact"]
    test_gate -> Retro     [label="Unit tests still failing after retries"]

    run_e2e -> e2e_gate
    e2e_gate -> screenshot [label="Pass", condition="outcome=succeeded"]
    e2e_gate -> developer  [label="Fix", condition="outcome=failed && internal.node_visit_count < 3", fidelity="compact"]
    e2e_gate -> Retro      [label="E2E still failing after retries"]

    // UI increments: screenshot → dev server → Preview gate → Retro.
    // Backend-only increments skip straight to Retro.
    screenshot -> serve [label="Preview UI", condition="plan.has_ui_surface=yes"]
    screenshot -> Retro
    serve -> Preview
    Preview -> Retro     [label="[A] Looks good — finish"]
    Preview -> developer [label="[R] Revise — back to Implement", freeform=true, fidelity="compact"]
    Preview -> Retro     [label="[S] Skip preview"]
    Preview -> exit      [label="Unanswered — abort", condition="outcome=failed"]
    Retro -> exit
}

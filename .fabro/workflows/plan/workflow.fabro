digraph Plan {
    graph [
        goal="Assess a module, clarify ambiguities with the human, produce a reviewable improvement plan aligned to the target architecture, gate it at Verification, then OPTIONALLY build it (UX → implement → verify → test → e2e) and finish with Retro"

        // Model routing — https://docs.fabro.sh/workflows/stylesheets
        //   .review    Assess + Clarify prep     codex @ low      (< 2 min each)
        //   .planning  Plan (Architect)           claude-opus-4-8 @ high
        //   .design    UX Designer                gpt-5.4 @ medium
        //   .build     Implement                  codex @ high
        //   .testing   Tester                     gpt-5.4 @ medium
        //   .retro     Retro                      gpt-5.4 @ medium
        model_stylesheet="
            *          { model: gpt-5.4;         reasoning_effort: medium; }
            .review    { model: codex;           reasoning_effort: low;    }
            .planning  { model: claude-opus-4-8; reasoning_effort: high;   }
            .design    { model: gpt-5.4;         reasoning_effort: medium; }
            .build     { model: codex;           reasoning_effort: high;   }
            .testing   { model: gpt-5.4;         reasoning_effort: medium; }
            .visual    { model: gpt-5.4;         reasoning_effort: medium; }
            .retro     { model: gpt-5.4;         reasoning_effort: medium; }
        "

        default_max_retries=1
        default_fidelity="summary:medium"

        // Plan phase budget: Scope+Assess+Clarify prep aim < 10 min to Clarify gate.
        // Build path (npm ci + Playwright + e2e) may need up to ~30 min.
        stall_timeout="1800s"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ── Scope ───────────────────────────────────────────────────────────
    // NOTE: `script` attributes do NOT render {{ inputs.module }} (Fabro only
    // templates `goal` and `prompt`). So we read the module from FABRO_INPUT_MODULE
    // (exported by the run) and fall back to storyteller. The Assess agent also
    // gets {{ inputs.module }} via its prompt, so targeting stays correct even if
    // this default is used.
    scope [
        label="Scope\n[shell · no agent]"
        shape=parallelogram
        script="M=\"${FABRO_INPUT_MODULE:-storyteller}\"; echo \"=== module: $M ===\"; find \"src/domains/$M\" -type f | sort | head -120; echo; echo '=== git status ==='; git status --short; echo; echo '=== architecture contract ==='; ls -la docs/unified/ARCHITECTURE.md docs/unified/SPEC.md 2>&1"
    ]

    // ── Assess: fast architecture alignment review (< 2 min) ──────────────
    // retry_policy=patient + fallback chain (workflow.toml) so a transient
    // provider error / usage limit retries and switches provider instead of
    // silently failing through to the human gate.
    assess [
        label="Assess\nagent: Architecture Assessor\nmodel: codex"
        class="review"
        prompt="@prompts/assess.md"
        retry_policy="patient"
        max_retries=2
        max_visits=2
    ]

    // ── Clarify prep: surface conflicts / open questions BEFORE the architect ─
    clarify_prep [
        label="Clarify Prep\nagent: Clarify Facilitator\nmodel: codex"
        class="review"
        prompt="@prompts/clarify-prep.md"
        retry_policy="patient"
        max_retries=2
        max_visits=2
    ]

    // ── HUMAN GATE: Clarify — one scope decision for the architect ─────────
    // clarify_prep puts the full brief in its stage summary (what the dock shows).
    // CLARIFY.md is architect reference only — not shown in the Fabro UI.
    // Answers land in run context as human.gate.* and DECISIONS.md via Plan.
    // https://docs.fabro.sh/workflows/human-in-the-loop
    Clarify [
        shape=hexagon
        label="How much should the cleanup plan take on?"
        question_type="multiple_choice"
        timeout="86400s"
    ]

    // ── Plan (Architect): writes PLAN.md ──────────────────────────────────
    // fidelity=summary:high so the architect sees your Clarify answer (incl.
    // freeform text via human.gate.text) in detail, not a compressed summary.
    // https://docs.fabro.sh/execution/context
    plan [
        label="Plan (Architect)\nagent: Plan Author\nmodel: claude-opus-4-8"
        class="planning"
        prompt="@prompts/plan.md"
        fidelity="summary:high"
        goal_gate=true
        retry_target="clarify_prep"
        max_visits=5
    ]

    // ── HUMAN GATE: Verification — plan approval; build is OPTIONAL ─────────
    // NO default_choice — fails closed until you answer (no auto-skip to Retro).
    Verification [
        shape=hexagon
        label="Plan is ready. Approve and build, save plan only, request changes, or abort?"
        question_type="multiple_choice"
        timeout="86400s"
    ]

    // ── OPTIONAL BUILD (only when you pick [B] Approve & build) ───────────
    // Docker sandbox clones origin fresh — no node_modules. Bootstrap runs once
    // at the start of the build path so hooks, verify, e2e, and screenshot work.
    setup [
        label="Bootstrap\n[shell · npm ci + Playwright]"
        shape=parallelogram
        script="set -euo pipefail; echo '=== sandbox bootstrap ==='; npm ci; npm run test:playwright:install; echo '=== bootstrap complete ==='"
        max_visits=2
    ]

    subgraph cluster_build {
        label="Optional Build"
        node [thread_id="build", fidelity="full"]

        ux_designer [
            label="UX Designer\nagent: UX Designer\nmodel: gpt-5.4"
            class="design"
            prompt="@../feature/prompts/ux-designer.md"
            max_visits=2
        ]

        developer [
            label="Implement\nagent: Developer\nmodel: codex"
            class="build"
            prompt="@prompts/implement.md"
            max_visits=4
        ]

        tester [
            label="Tester\nagent: Tester\nmodel: gpt-5.4"
            class="testing"
            prompt="@../feature/prompts/tester.md"
            max_visits=3
        ]

        // Browser capture via Playwright MCP (configured in workflow.toml).
        // Best-effort visual evidence → screenshots/ (auto-collected artifacts).
        // Vision-capable model; never blocks the run (single edge onward to Retro).
        screenshot [
            label="UI Screenshot\nagent: UI Screenshotter\nmodel: gpt-5.4 (vision) + Playwright MCP"
            class="visual"
            prompt="@prompts/screenshot.md"
            retry_policy="patient"
            max_retries=1
            max_visits=2
        ]
    }

    verify [
        label="Typecheck + Lint\n[shell · no agent]"
        shape=parallelogram
        script="npm run typecheck && npm run lint"
        max_visits=5
    ]
    verify_gate [shape=diamond, label="Static checks pass?"]

    run_tests [
        label="Unit Tests\n[shell · npm run test:unit]"
        shape=parallelogram
        script="npm run test:unit"
        max_visits=5
    ]
    test_gate [shape=diamond, label="Unit tests pass?"]

    run_e2e [
        label="E2E Full\n[shell · npm run test:e2e full-loop]"
        shape=parallelogram
        script="npm run test:e2e full-loop"
        max_visits=3
    ]
    e2e_gate [shape=diamond, label="E2E pass?"]

    // ── Retro ─────────────────────────────────────────────────────────────
    Retro [
        label="Retro\nagent: Retro Author\nmodel: gpt-5.4"
        class="retro"
        prompt="@prompts/retro.md"
        max_visits=2
    ]

    // ── Wiring ───────────────────────────────────────────────────────────
    start -> scope -> assess -> clarify_prep -> Clarify

    Clarify -> plan [label="[A] Staged migration — boundaries first, bigger moves sequenced"]
    Clarify -> plan [label="[B] Minimal first step — public API and import boundaries only"]
    Clarify -> plan [label="[C] Full blueprint — comprehensive end-state migration plan"]
    Clarify -> plan [label="[F] Custom scope rules", freeform=true]
    Clarify -> assess [label="[R] Re-assess — findings are wrong or stale"]

    plan -> Verification

    // IMPORTANT: no `condition` on human-gate edges. Fabro evaluates condition
    // edges BEFORE the human's preferred_label, so a condition like
    // "outcome=succeeded" (always true after answering) would hijack every
    // choice and jump to that edge. Human-gate routing must rely on
    // preferred_label matching only.
    Verification -> setup      [label="[B] Approve & build"]
    setup -> ux_designer
    Verification -> Retro       [label="[P] Approve, plan only"]
    Verification -> plan        [label="[I] Iterate with notes", freeform=true]
    Verification -> exit        [label="[X] Abort"]

    ux_designer -> developer -> verify -> verify_gate

    verify_gate -> tester    [label="Pass", condition="outcome=succeeded"]
    verify_gate -> developer [label="Fix"]

    tester -> run_tests -> test_gate

    test_gate -> run_e2e [label="Pass", condition="outcome=succeeded"]
    test_gate -> developer [label="Fix"]

    run_e2e -> e2e_gate
    e2e_gate -> screenshot [label="Pass", condition="outcome=succeeded"]
    e2e_gate -> developer  [label="Fix"]

    // Screenshot is best-effort: single unconditional edge → proceeds to Retro
    // even if capture fails, so it never blocks shipping.
    screenshot -> Retro

    Retro -> exit
}

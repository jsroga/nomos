digraph Cleanup {
    graph [
        goal="Review the target, produce a prioritized cleanup plan, get human approval, then execute the approved cleanup and verify it (typecheck, lint, unit tests) without changing behavior"
        // Reviews run on a fast, cheap model at low effort so each finishes in
        // ~1.5-2 min. The plan and the actual code changes run on the stronger
        // model because their quality matters more than their speed.
        model_stylesheet="
            *          { model: gpt-5.4-mini; reasoning_effort: low;    }
            .review    { model: gpt-5.4-mini; reasoning_effort: low;    }
            .planning  { model: gpt-5.4;      reasoning_effort: medium; }
            .build     { model: gpt-5.4;      reasoning_effort: high;   }
        "
        default_max_retries=1
        stall_timeout="1800s"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // ── Scope: give reviewers a starting map (changed files + tree) ──
    scope [
        label="Scope"
        shape=parallelogram
        script="echo '=== git status ==='; git status --short; echo; echo '=== recent commits ==='; git log --oneline -10 || true"
    ]

    // ── Fast review across three lenses ──────────────────────────────
    // NOTE ON PARALLELISM: this repo runs Fabro in LOCAL sandbox mode (no
    // Daytona). Empirically, local mode can only initialize ONE agent session
    // at a time — when 2+ review branches start together, all but one die at
    // ~100-200ms (before any LLM call) and do NOT recover via retry. So we set
    // max_parallel=1 (serial) for reliability. Each review is still FAST
    // (gpt-5.4-mini, low effort, tight prompts ⇒ ~1.5-2 min each), so the whole
    // fan is ~5-6 min. To get TRUE parallelism, enable the cloud sandbox:
    //   fabro secret set DAYTONA_API_KEY <key>
    // then bump max_parallel back to 3-4 (each branch gets an isolated sandbox).
    fan [
        label="Review (fan-out)"
        shape=component
        join_policy="wait_all"
        max_parallel=1
        max_visits=2
    ]

    security_review [
        label="Security Review"
        class="review"
        prompt="@prompts/security-review.md"
        retry_policy="patient"
        max_retries=3
        max_visits=3
    ]
    architecture_review [
        label="Architecture Review"
        class="review"
        prompt="@prompts/architecture-review.md"
        retry_policy="patient"
        max_retries=3
        max_visits=3
    ]
    quality_review [
        label="Quality Review"
        class="review"
        prompt="@prompts/quality-review.md"
        retry_policy="patient"
        max_retries=3
        max_visits=3
    ]

    merge [
        label="Merge Findings"
        shape=tripleoctagon
    ]

    // ── Synthesize findings into the cleanup plan (the thing you review) ──
    plan [
        label="Cleanup Plan"
        class="planning"
        prompt="@prompts/improvement-plan.md"
        max_visits=4
    ]

    // ── HUMAN GATE — approve the PLAN before any code is touched ─────
    approve [
        shape=hexagon
        label="Review the cleanup plan (IMPROVEMENT_PLAN.md). Approve to execute the cleanup, send it back for revision with notes, or stop with the plan only."
        question_type="multiple_choice"
        human.default_choice="implement"
        timeout="86400s"
    ]

    // ── Execute the approved cleanup (the only code-modifying node) ──
    implement [
        label="Execute Cleanup"
        class="build"
        prompt="@prompts/implement-cleanup.md"
        max_visits=6
    ]

    // ── Verify chain: cheap→expensive gates with a fix loop back to implement ──
    verify_types [
        label="Typecheck"
        shape=parallelogram
        script="npm run typecheck > /tmp/cleanup-typecheck.log 2>&1; code=$?; tail -80 /tmp/cleanup-typecheck.log; exit $code"
        max_visits=6
    ]
    gate_types [shape=diamond, label="Types pass?"]

    verify_lint [
        label="Lint"
        shape=parallelogram
        script="npm run lint > /tmp/cleanup-lint.log 2>&1; code=$?; tail -80 /tmp/cleanup-lint.log; exit $code"
        max_visits=6
    ]
    gate_lint [shape=diamond, label="Lint pass?"]

    verify_test [
        label="Unit Tests"
        shape=parallelogram
        script="npm run test:unit > /tmp/cleanup-test.log 2>&1; code=$?; tail -100 /tmp/cleanup-test.log; exit $code"
        max_visits=6
    ]
    gate_test [shape=diamond, label="Tests pass?"]

    // ── Final goal gate: confirm the cleanup is real & behavior-preserving ──
    done [
        label="Verify Done"
        class="planning"
        prompt="@prompts/done.md"
        goal_gate=true
        retry_target="implement"
        fallback_retry_target="approve"
        max_visits=2
    ]

    // ── Wiring ───────────────────────────────────────────────────────
    start -> scope -> fan

    fan -> security_review     -> merge
    fan -> architecture_review -> merge
    fan -> quality_review      -> merge

    merge -> plan -> approve

    approve -> implement [label="[A] Approve & execute cleanup"]
    approve -> plan      [label="[R] Revise plan with notes", freeform=true]
    approve -> exit      [label="[X] Stop — plan only"]

    // implement → typecheck → lint → tests, failing back to implement
    implement -> verify_types -> gate_types
    gate_types -> verify_lint [label="Pass", condition="outcome=succeeded"]
    gate_types -> implement   [label="Fix type errors"]

    verify_lint -> gate_lint
    gate_lint -> verify_test [label="Pass", condition="outcome=succeeded"]
    gate_lint -> implement   [label="Fix lint errors"]

    verify_test -> gate_test
    gate_test -> done      [label="Pass", condition="outcome=succeeded"]
    gate_test -> implement [label="Fix failing tests"]

    done -> exit
}

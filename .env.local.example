# Copy to .env.local and fill in. Grouped by what you actually need first.

# ============================================================
# REQUIRED — app won't boot / core loop broken without these
# ============================================================

# Supabase (Postgres + auth/RLS). URL + anon are public; service-role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Postgres connection string (Drizzle + Mastra store). Usually the Supabase pooled URL.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ============================================================
# LLM — single OpenRouter key routes every model (Mastra gateway).
# All agents/scorers default to `openrouter/auto-beta`; one key is enough.
# ============================================================
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# Pin any role to a specific OpenRouter model id — provider/model form, routed
# through the same key (the gateway prefix is added automatically), e.g.:
# STORYTELLER_AUTHOR_MODEL=moonshotai/kimi-k2.7-code
# GAME_DESIGN_MODEL=openai/gpt-5.6-luna
# LOOP_CREATOR_MODEL=anthropic/claude-sonnet-4.5
# JUDGING_MODEL=anthropic/claude-sonnet-4.5
# Per-provider keys are no longer required — even GLM (z-ai/glm-5.2) and Kimi
# (moonshotai/kimi-k2.7-code) route through OpenRouter. Only remaining exception:
#   - embeddings (OpenRouter has no unified embeddings gateway) → OPENAI_API_KEY
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Do NOT set ANTHROPIC_BASE_URL unless you run a local Anthropic proxy on that host.

# Local app URL (OAuth + email redirects — must match Supabase redirect allowlist).
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Central/Admin users (comma-separated emails): lock the bible, bypass onboarding, advanced features.
NEXT_PUBLIC_CENTRAL_USERS=jacek.sroga.itc@gmail.com

# ============================================================
# AUTHOR MODEL — the writers-room picker offers Kimi 2.7 and GLM 5.2,
# both routed through OpenRouter on OPENROUTER_API_KEY (no separate keys).
# Default author is openrouter/auto-beta; pin a role via STORYTELLER_<ROLE>_MODEL.
# ============================================================
# STORYTELLER_AUTHOR_MODEL=moonshotai/kimi-k2.7-code
# STORYTELLER_AUTHOR_MODEL=z-ai/glm-5.2

# ============================================================
# EVALUATIONS — LLM judges for Mastra scorers (npm run eval)
# ============================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# JUDGING_MODEL=anthropic:claude-sonnet-4-20250514
# Scratch project/episode for the wildcards A/B experiment (evals/experiments/wildcards-ab.ts):
# WILDCARDS_AB_PROJECT_ID=
# WILDCARDS_AB_EPISODE_ID=
# Scratch project/episode for the beat-draft workflow e2e test:
# WORKFLOW_E2E_PROJECT_ID=
# WORKFLOW_E2E_EPISODE_ID=

# ============================================================
# BACKGROUND TASKS — image/moodboard/storyboard/3D (Trigger.dev)
# ============================================================
# TRIGGER_SECRET_KEY=tr_dev_...
LEGNEXT_API_KEY=your-legnext-api-key         # image generation (Midjourney via LegNext)
GOOGLE_API_KEY=your-google-api-key           # tiles + fidelity + Gemini pre-upscale (Nano Banana)
STABILITY_API_KEY=your-stability-api-key     # upscale default
# BLOB_READ_WRITE_TOKEN=vercel_blob_...      # asset storage (Vercel Blob)
# REPLICATE_API_TOKEN=your-replicate-token   # upscale alternative

# ============================================================
# FEATURE FLAGS — storyteller experimental paths (default OFF)
# ============================================================
# Plan-first AgentController path for chat (PLAN-V2 Phase 4):
# STORYTELLER_CONTROLLER=1
# Durable autonomous drafting loop (goals + durable agents):
# STORYTELLER_AUTONOMOUS=1
# ENABLE_REMOTE_PROMPTS=true                 # local prompt registry only (remote hub disabled)
# STORYTELLER_PROMPT_ENV=dev

# ============================================================
# OPTIONAL — feature-specific; skip unless you use them
# ============================================================
# COHERE_API_KEY=            # RAG reranker (has a heuristic fallback — safe to omit)
# VOYAGE_API_KEY=            # embeddings
# FAL_KEY=                   # 3D asset generation
# MESHY_API_KEY=             # 3D asset generation
# HYPER3D_API_KEY=           # 3D asset generation
# OPENROUTER_API_KEY=        # alternative model routing
# TAVILY_API_KEY=            # loop-creator market analyst (web search)
# TWITTER_BEARER_TOKEN=      # loop-creator market analyst (trends)
# REDDIT_CLIENT_SECRET=      # loop-creator market analyst
# MCP_API_KEY=               # MCP server auth
# Required to access /docs/internal routes (no fallback — unset = locked):
INTERNAL_DOCS_SECRET=your-internal-docs-secret

# --- Legacy / rarely needed ---
# USE_HANDOFFS_PATTERN=false
# LANGCHAIN_API_KEY=your-key

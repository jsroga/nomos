# Copy to .env.local and fill in. Grouped by what you actually need first.
# When changing vars, update this file and .env.local together (same keys; secrets stay local).

# ============================================================
# REQUIRED — app won't boot / core loop broken without these
# ============================================================

# Supabase (Postgres + auth/RLS). Use these names only — not SUPABASE_URL / publishable / secret aliases.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Postgres connection string (Drizzle + Mastra store). Usually the Supabase pooled URL.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

TRIGGER_SECRET_KEY=tr_dev_...                # every tasks.trigger() call from the app

# ============================================================
# LLM — one OpenRouter key routes every text model (OpenAI / Anthropic / Google / Kimi / GLM).
# Per-slot pins (STORYTELLER_*_MODEL, GAME_DESIGN_MODEL, JUDGING_MODEL, …):
# docs/DEVELOPMENT.md § Model routing
# ============================================================
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# EMBEDDING_MODEL=openai/text-embedding-3-small  # RAG embeddings via OpenRouter; also needs FF_VOYAGE_EMBEDDINGS=true
# Optional direct-vendor keys — redundant when OPENROUTER_API_KEY is set (legacy / escape hatch only):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CENTRAL_USERS=jacek.sroga.itc@gmail.com

# ============================================================
# EVALUATIONS — LLM judges via OpenRouter (JUDGING_MODEL); npm run eval
# ============================================================
# JUDGING_MODEL=openai/gpt-5.6-sol

# ============================================================
# HTTP AUTH — Playwright e2e bypass + optional whole-site Basic Auth
# ============================================================
E2E_BYPASS_AUTH_SECRET=0a3206f0ef081e295574234d3dabb296749ff09ce74828dd6b6a5317bbc82605
BASIC_AUTH_USER=                             # proxy Basic Auth user; leave empty with password unset to disable
BASIC_AUTH_PASSWORD=                         # unset password disables Basic Auth

# ============================================================
# E2E / PREVIEW — scratch projects + Vercel preview deploy
# ============================================================
# VERCEL_TOKEN=vercel_...                    # required for npm run test:e2e:preview (deploy to Vercel first)
# VERCEL_PROJECT=prj_...                     # Vercel project id for e2e env sync / preview deploy
# WILDCARDS_AB_PROJECT_ID=                 # scratch project for evals/experiments/wildcards-ab.ts
# WILDCARDS_AB_EPISODE_ID=
# WORKFLOW_E2E_PROJECT_ID=                 # scratch project for beat-draft workflow e2e
# WORKFLOW_E2E_EPISODE_ID=

# ============================================================
# BACKGROUND TASKS — image/moodboard/storyboard/3D (Trigger.dev)
# ============================================================
APIFRAME_API_KEY=afk_your-apiframe-api-key   # sole image gateway (https://apiframe.ai)
# BLOB_READ_WRITE_TOKEN=vercel_blob_...      # asset storage (Vercel Blob)

# Image models (Apiframe generate + Topaz upscale). Generate: midjourney | nano-banana | nano-banana-pro | grok-imagine-image | gpt-image-1.5 | flux-2-pro
IMAGE_TILE_FIRST_MODEL=midjourney
IMAGE_TILE_FOLLOW_UP_MODEL=grok-imagine-image
IMAGE_MOODBOARD_MODEL=midjourney
IMAGE_STORYBOARD_MODEL=nano-banana
IMAGE_COMBINED_STORYBOARD_MODEL=nano-banana-pro
IMAGE_STORYBOARD_VIDEO_MODEL=kling-3.0   # CorkBoard fallback when the dropdown is unused; UI picks model × film|storyboard
IMAGE_STORYBOARD_VIDEO_DURATION=15       # ignored; CorkBoard storyboard video is hardcoded to 15s
IMAGE_EPISODE_POSTER_MODEL=nano-banana
IMAGE_SERIES_POSTER_MODEL=midjourney
IMAGE_PORTRAIT_MODEL=midjourney
# Fidelity: grok-imagine-image | topaz-image-upscale | nano-banana | nano-banana-pro | gpt-image-1.5 | flux-2-pro
IMAGE_FIDELITY_MODEL=grok-imagine-image
# Used only when IMAGE_FIDELITY_MODEL=topaz-image-upscale
IMAGE_FIDELITY_MODE=redefine
# Upscale: always Topaz. Mode: standard | creative
IMAGE_UPSCALE_MODEL=topaz-image-upscale
IMAGE_UPSCALE_MODE=standard
# Repaint: gpt-image-2
IMAGE_REPAINT_MODEL=gpt-image-2

# REPLICATE_API_TOKEN=your-replicate-token   # SAM / interior textures
# FAL_KEY=                   # 3D / segmentation
# MESHY_API_KEY=             # 3D asset generation
# HYPER3D_API_KEY=           # 3D asset generation

# ============================================================
# FEATURE FLAGS
# ============================================================
# Opt-in flags are `FF_<NAME>=true`. Any other value is off. docs/DEVELOPMENT.md § Feature flags
# FF_STORYTELLER_CONTROLLER=true             # plan-first AgentController path for chat
# FF_STORYTELLER_AUTONOMOUS=true             # durable autonomous drafting loop (goals + durable agents)
# FF_LOOP_CREATOR_MASTRA=true                # loop-creator chat via Mastra instead of the legacy adapter
# FF_REMOTE_PROMPTS=true                     # pull prompts from the remote hub instead of the local registry
# FF_INTERNAL_DOCS=true                      # expose GET /api/settings/models in production (signed-in users)
# INTERNAL_DOCS_SECRET=                      # required with FF_INTERNAL_DOCS in production
# FF_CANVAS_GEMINI_UPSCALE=true              # Gemini pre-upscale before Topaz (comparison)
# FF_TILE_SEAM_COLOR_FADE=true               # 16px follow-up edge color fade after packed crop
# NEXT_PUBLIC_FF_3D_CANVAS=true              # show 3D Canvas in the workspace sidebar and project hub
# NEXT_PUBLIC_FF_LOOP_CREATOR=true           # show Loop Creator in the workspace sidebar and project hub
FF_VOYAGE_EMBEDDINGS=true                    # RAG embeddings via OpenRouter; off = mock vectors

# ============================================================
# OBSERVABILITY — Mastra AI tracing (spans/logs/scores)
# Traces persist to the Mastra store whenever DATABASE_URL is set; everything
# below is opt-in on top of that. docs/DEVELOPMENT.md § Observability
# Studio discovery/feedback needs PostgresStoreVNext (default in create-mastra).
# ============================================================
# OBSERVABILITY_DATABASE_URL=  # dedicated observability DB (else DATABASE_URL)
# MASTRA_PLATFORM_ACCESS_TOKEN=  # also export to Mastra Cloud
# MASTRA_PLATFORM_PROJECT_ID=
# MASTRA_TRACE_CONSOLE=true      # print spans (debug without a database)
# MASTRA_TRACE_SAMPLE_RATIO=0.1  # 0..1; unset = sample everything
# MASTRA_TRACE_MODEL_CHUNKS=true # keep per-token chunk spans (very high volume)
# MASTRA_OBSERVABILITY_LOG_LEVEL=info   # debug|info|warn|error|fatal
# OTEL_SERVICE_NAME=tilemap-storyteller # @vercel/otel + Sentry request traces
# NEXT_PUBLIC_FF_CWV_HUD=true    # live Core Web Vitals overlay (LCP/INP/CLS + attribution)
# NEXT_PUBLIC_FF_PERF_DEBUG=true # React Scan + CWV HUD + 3d-canvas renderer HUD
# ANALYZE=true                   # webpack bundle analyzer on next build --webpack

# Landing hero A/B — sticky cookie `lp_hero` = a|b; unset = 50/50. docs/DEVELOPMENT.md § Landing A/B
# LANDING_HERO_AB_A_PCT=50
# LANDING_HERO_AB_B_PCT=50

# ============================================================
# OPTIONAL — feature-specific; skip unless you use them
# ============================================================
# TAVILY_API_KEY=            # loop-creator market analyst (web search)
# TWITTER_BEARER_TOKEN=      # loop-creator market analyst (trends)
# REDDIT_CLIENT_ID=          # loop-creator market analyst (both id + secret required)
# REDDIT_CLIENT_SECRET=      # loop-creator market analyst
# MCP_API_KEY=               # MCP server auth
# DEV_USER_ID=               # MCP server: skip auth and act as this user (local only)
# STORYTELLER_CHAT_MODEL=moonshotai:kimi-k3   # Writers Room default when picker unset; not used by author/planner/critics
# STORYTELLER_AUTHOR_MODEL=moonshotai:kimi-k3 # beat-draft GRRM author
# STORYTELLER_PLANNER_MODEL=anthropic:claude-opus-4-8
# STORYTELLER_CRITIC_MODEL=anthropic:claude-haiku-4-5
# STORYTELLER_MUSE_MODEL=moonshotai:kimi-k3
# STORYTELLER_PREMISE_MODEL=anthropic:claude-opus-4-8

# ============================================================
# OPTIONAL — every key the code reads, kept in step with
# src/shared/config/env.ts by `npm run env:check`
# ============================================================

# Direct provider keys. Text generation normally goes through OPENROUTER_API_KEY;
# these are only read where a provider is called directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Image and 3D providers. Absent means that generator is unavailable, not broken.
MESHY_API_KEY=
HYPER3D_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# Research tools used by the loop-creator market analyst.
TAVILY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# Vercel Blob. Required only by the tasks that upload generated assets.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN=

# MCP server. DEV_USER_ID is the local stdio bypass identity.
MCP_API_KEY=
DEV_USER_ID=

# Model overrides. Unset falls back to the catalog default.
EMBEDDING_MODEL=
JUDGING_MODEL=
STORYTELLER_CHAT_MODEL=
NEXT_PUBLIC_DEFAULT_AGENT_MODEL=

# Mastra Studio workspace root, when it is not the repo root.
MASTRA_PROJECT_ROOT=

# Debug switches. `true` turns one on; anything else is off.
STORYTELLER_VERBOSE=
STORYTELLER_LOG_DECISIONS=
STORYTELLER_LOG_RAG=

# Base URLs. NEXT_PUBLIC_VERCEL_URL is set by the platform on deployments.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_VERCEL_URL=

# Add this to your .env.local file

# Central/Admin Users (comma-separated emails)
# These users can:
# - Lock/unlock the Series Bible
# - Bypass onboarding
# - Access advanced features
NEXT_PUBLIC_CENTRAL_USERS=jacek.sroga.itc@gmail.com

# Evaluation — Mastra scorers (requires OpenAI for LLM judges)
# OPENAI_API_KEY=sk-your-openai-key-here
# JUDGING_MODEL=anthropic:claude-sonnet-4-20250514

# --- AI Provider Keys (server-side, used by API routes) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# Do NOT set ANTHROPIC_BASE_URL unless you run a local Anthropic proxy on that host.

# Z.AI (Zhipu) — GLM 5.2 via the Coding Plan endpoint.
# Endpoint: https://api.z.ai/api/coding/paas/v4  (OpenAI-compatible chat completions)
# Requires an active Z.AI Coding Plan subscription for the glm-5.2 model id.
# ZHIPU_API_KEY=your-zai-api-key-here

# Moonshot AI — Kimi 2.7 (kimi-k2.7-code).
# Endpoint: https://api.moonshot.ai/v1  (OpenAI-compatible)
# MOONSHOT_API_KEY=your-moonshot-api-key-here
LEGNEXT_API_KEY=your-legnext-api-key
# Follow-up tiles + fidelity + Gemini pre-upscale:
GOOGLE_API_KEY=your-google-api-key
# Upscale default provider (Stability AI):
STABILITY_API_KEY=your-stability-api-key
# Upscale alternative (optional, Replicate):
# REPLICATE_API_TOKEN=your-replicate-token

# --- Internal docs auth ---
# Required to access /docs/internal routes (no fallback — unset = locked)
INTERNAL_DOCS_SECRET=your-internal-docs-secret

# --- Langfuse (observability + remote prompts) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# ENABLE_REMOTE_PROMPTS=true
# STORYTELLER_PROMPT_ENV=dev

# Local app URL (OAuth + email redirects — must match Supabase redirect allowlist)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Trigger.dev (background tasks — portrait, moodboard, storyboard, etc.)
# TRIGGER_SECRET_KEY=tr_dev_...

# USE_HANDOFFS_PATTERN=false
# LANGCHAIN_API_KEY=your-key
